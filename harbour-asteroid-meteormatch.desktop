[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-asteroid-meteormatch
Exec=sailfish-qml harbour-asteroid-meteormatch
Name=Meteor Match
Comment=Match falling rocks

[X-Sailjail]
# Sandboxed. The game needs no permissions: it only writes its own
# config directory, ~/.config/net.mowerk/harbour-asteroid-meteormatch/.
OrganizationName=net.mowerk
ApplicationName=harbour-asteroid-meteormatch
Permissions=
